# Copy this file to .env before running Docker Compose.
POSTGRES_USER=follow
POSTGRES_DB=follow
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Administrator maintained by the API at startup.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# 6-128 characters with uppercase, lowercase, number, and special character; no whitespace.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

MINIO_ROOT_USER=follow
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password

# Optional server-side library import. This is read only when the opt-in
# docker-compose.import.yml overlay is included. The host directory must already exist.
# FOLLOW_IMPORT_SOURCE_PATH=/absolute/path/to/music-library

# The API image pins Chromaprint/fpcalc 1.6.1 and its checksums internally.
# Fingerprint algorithm, length, timeout, and output bounds are explicit in
# docker-compose.yml and should be changed only with calibration evidence.
