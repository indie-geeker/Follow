# ================================
# Flutter Project .gitignore
# ================================

# ----------------
# Miscellaneous
# ----------------
*.class
*.log
*.pyc
*.swp
*.swo
*~
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ----------------
# IDE/Editor
# ----------------
# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code (uncomment if you don't want to share settings)
# .vscode/

# Claude AI
.claude/

# ----------------
# Flutter/Dart/Pub
# ----------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/

# Generated code (Freezed, json_serializable, auto_route, etc.)
*.g.dart
*.freezed.dart
*.gr.dart
*.mocks.dart
lib/generated/
.packages

# ----------------
# Environment files
# ----------------
.env
.env.*
!.env.example
*.local

# ----------------
# Symbolication & Obfuscation
# ----------------
app.*.symbols
app.*.map.json

# ----------------
# Android
# ----------------
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle/
/android/local.properties
/android/*.iml
/android/key.properties
/android/app/google-services.json

# ----------------
# iOS
# ----------------
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Flutter/Generated.xcconfig
/ios/Flutter/app.flx
/ios/Flutter/engine
/ios/Flutter/flutter_export_environment.sh
/ios/ServiceDefinitions.json
/ios/Runner/GeneratedPluginRegistrant.*

# ----------------
# macOS
# ----------------
/macos/Pods/
/macos/.symlinks/
/macos/Flutter/GeneratedPluginRegistrant.swift
/macos/Flutter/ephemeral/

# ----------------
# Windows
# ----------------
/windows/flutter/generated_plugin_registrant.cc
/windows/flutter/generated_plugin_registrant.h
/windows/flutter/generated_plugins.cmake

# ----------------
# Linux
# ----------------
/linux/flutter/generated_plugin_registrant.cc
/linux/flutter/generated_plugin_registrant.h
/linux/flutter/generated_plugins.cmake

# ----------------
# Web
# ----------------
/web/favicon.png
/web/icons/
