{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {},
  "JwtSettings": {
    "Issuer": "FollowMusicApi",
    "Audience": "FollowMusicClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "MinioSettings": {
    "BucketName": "follow-music",
    "UseSSL": false
  },
  "RedisSettings": {
    "ConnectionString": "localhost:6379"
  },
  "AudioFingerprint": {
    "ExecutablePath": "fpcalc",
    "Algorithm": 2,
    "MaximumLengthSeconds": 120,
    "TimeoutSeconds": 30,
    "MaximumStandardOutputBytes": 2097152,
    "MaximumStandardErrorBytes": 16384,
    "MaximumSourceBytes": 2147483648,
    "TemporaryDirectory": "",
    "RequiredVersionPrefix": "1.6.1",
    "CandidateSimilarityThreshold": 0.85,
    "MatchSimilarityThreshold": 0.99,
    "MinimumSegmentSimilarity": 0.98,
    "MinimumCoverageFraction": 0.85,
    "MaximumDurationDifferenceSeconds": 2,
    "MaximumAlignmentOffsetFrames": 2,
    "MaximumCandidateAlignmentOffsetFrames": 512,
    "SegmentCount": 3
  },
  "MusicImport": {
    "Enabled": false,
    "SourceRoot": "",
    "SourceAlias": "只读挂载的音乐目录",
    "MaximumFileBytes": 2147483648,
    "MaximumRelativePathLength": 1024,
    "ScanBatchSize": 500,
    "ProcessingConcurrency": 1,
    "LeaseMinutes": 15
  },
  "RateLimiting": {
    "Register": { "PermitLimit": 3, "WindowSeconds": 3600 },
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Refresh": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Api": { "PermitLimit": 120, "WindowSeconds": 60 },
    "Upload": { "PermitLimit": 20, "WindowSeconds": 3600 },
    "Stream": { "PermitLimit": 3 }
  }
}
